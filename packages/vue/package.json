{
  "name": "@viewflow/material-vue",
  "version": "26.28.1",
  "description": "Vue 3 bindings for @viewflow/material — Material 3 web components, with v-model and Nuxt server rendering.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewflow/material.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "material-design",
    "material-3",
    "vue",
    "nuxt",
    "web-components"
  ],
  "type": "module",
  "main": "./dist/components.js",
  "types": "./dist/components.d.ts",
