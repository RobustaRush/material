  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/vue-output-target": "^0.14.1"
  },
  "peerDependencies": {
    "@viewflow/material": "^26.28.1",
