{
  "name": "@viewflow/material-react",
  "version": "26.28.1",
  "description": "React bindings for @viewflow/material — Material 3 web components, with Next.js/RSC server rendering.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewflow/material.git",
    "directory": "packages/react"
  },
  "keywords": [
    "material-design",
    "material-3",
    "react",
    "nextjs",
    "web-components"
  ],
  "type": "module",
  "main": "./dist/components.js",
  "types": "./dist/components.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./ssr": {
      "types": "./dist/components.server.d.ts",
      "import": "./dist/components.server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "^1.6.1"
  },
  "peerDependencies": {
    "@viewflow/material": "^26.28.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@viewflow/material": "file:../..",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
