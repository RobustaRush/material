{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "strict": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    // The value-accessor host bindings the output target generates index
    // `$event.target` (`$event.target?.["value"]`), which Angular's host
    // binding type checker rejects under noImplicitAny. This only relaxes the
    // check for this generated library; consumers' own strictness is untouched.
    "strictTemplates": false,
    "typeCheckHostBindings": false
  },
  "include": ["src"]
}
