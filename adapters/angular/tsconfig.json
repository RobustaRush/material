{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "strict": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    // Self-reference: adapters/angular needs its own package.json (ng-packagr
    // requires one), which is the nearest ancestor for files under src/ and
    // shadows the real root's — so plain self-reference resolution never
    // reaches material/package.json's exports map. These paths only steer
    // the type-checker there directly; the emitted .mjs keeps the bare
    // `@viewflow/material/...` specifier, which real consumers resolve
    // normally (the installed package's own node_modules entry, not this).
    "paths": {
      "@viewflow/material/dist/components": ["../../dist/components/index.d.ts"],
      "@viewflow/material/dist/components/*": ["../../dist/components/*"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    // The value-accessor host bindings the output target generates index
    // `$event.target` (`$event.target?.["value"]`), which Angular's host
    // binding type checker rejects under noImplicitAny. This only relaxes the
    // check for this generated library; consumers' own strictness is untouched.
    "strictTemplates": false,
    "typeCheckHostBindings": false
  },
  "include": ["src"]
}
