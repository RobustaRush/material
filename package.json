{
  "name": "advanced-material-web",
  "version": "26.28.1",
  "description": "Material 3 web components built with Stencil — self-contained shadow-DOM styles, swappable theme via CSS custom properties, zero required stylesheet fetch.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewflow/material.git"
  },
  "keywords": [
    "material-design",
    "material-3",
    "md3",
    "web-components",
    "custom-elements",
    "stencil",
    "design-system",
    "ui-components"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/components.d.ts",
  "unpkg": "cdn/material.min.js",
  "jsdelivr": "cdn/material.min.js",
  "sideEffects": true,
  "customElements": "dist/custom-elements.json",
  "web-types": "dist/web-types.json",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": "./dist/components/*",
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.mjs",
      "require": "./hydrate/index.js"
    },
    "./cdn": "./cdn/material.min.js",
    "./theme.css": "./css/theme.css",
    "./material.css": "./css/material.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./html-data.json": "./dist/html-data.json",
    "./web-types.json": "./dist/web-types.json",
    "./docs.json": "./dist/docs.json",
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/*": "./dist/*",
    "./react": {
      "types": "./adapters/react/dist/components.d.ts",
      "import": "./adapters/react/dist/components.js"
    },
    "./react/ssr": {
      "types": "./adapters/react/dist/components.server.d.ts",
      "import": "./adapters/react/dist/components.server.js"
    },
    "./vue": {
      "types": "./adapters/vue/dist/components.d.ts",
      "import": "./adapters/vue/dist/components.js"
    },
    "./angular": {
      "types": "./adapters/angular/dist/types/advanced-material-web-angular.d.ts",
      "default": "./adapters/angular/dist/fesm2022/advanced-material-web-angular.mjs"
    },
    "./svelte": {
      "types": "./adapters/svelte/src/index.d.ts",
      "svelte": "./adapters/svelte/src/index.js",
      "default": "./adapters/svelte/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/components/",
    "dist/esm/",
    "dist/material/",
    "dist/types/",
    "dist/index.js",
    "dist/custom-elements.json",
    "dist/html-data.json",
    "dist/web-types.json",
    "dist/docs.json",
    "hydrate/",
    "loader/",
    "cdn/material.min.js",
    "css/theme.css",
    "css/material.css",
    "adapters/react/dist/",
    "adapters/vue/dist/",
    "adapters/angular/dist/fesm2022/",
    "adapters/angular/dist/types/",
    "adapters/svelte/src/",
    "LICENSE",
    "LICENSE_EXCEPTION"
  ],
  "scripts": {
    "build": "npm run build:theme && npm run build:theme:pkg && npm run build:material:pkg && npm run build:css && stencil build && npm run build:types && npm run check:svelte && npm run build:web-types && npm run build:cdn && npm run license:generated",
    "build:all": "npm run build && npm run build:adapters",
    "build:adapters": "npm run build:adapters:react && npm run build:adapters:vue && npm run build:adapters:angular",
    "build:adapters:react": "tsc -p adapters/react/tsconfig.json",
    "build:adapters:vue": "tsc -p adapters/vue/tsconfig.json",
    "build:adapters:angular": "ng-packagr -p adapters/angular/ng-package.json -c adapters/angular/tsconfig.json",
    "build:types": "node scripts/patch-custom-element-types.mjs",
    "build:web-types": "node scripts/build-web-types.mjs",
    "license": "node scripts/license-header.mjs",
    "license:check": "node scripts/license-header.mjs --check",
    "license:generated": "node scripts/license-header.mjs --generated",
    "build:css": "tailwindcss -i ./src/global/material.css -o ./www/static/material/material.css --minify",
    "build:theme": "tailwindcss -i ./src/theme/theme.css -o ./www/static/material/theme.css --minify",
    "build:theme:pkg": "tailwindcss -i ./src/theme/theme.css -o ./css/theme.css --minify",
    "build:material:pkg": "node scripts/build-material-css.mjs",
    "build:cdn": "node scripts/build-cdn.mjs",
    "dev:css": "tailwindcss -i ./src/global/material.css -o ./www/static/material/material.css --watch",
    "dev:theme": "tailwindcss -i ./src/theme/theme.css -o ./www/static/material/theme.css --watch",
    "start": "MATERIAL_WRAPPERS=0 concurrently -k -n theme,css,stencil -c green,blue,magenta \"npm:dev:theme\" \"npm:dev:css\" \"stencil build --dev --watch --serve\"",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build:all",
    "check:svelte": "node scripts/check-svelte-output.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vue-output-target": "^0.14.1",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "rxjs": "^7.8.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": { "optional": true },
    "@angular/core": { "optional": true },
    "@angular/forms": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "rxjs": { "optional": true },
    "svelte": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@stencil/angular-output-target": "^1.4.1",
    "@stencil/core": "^4.22.0",
    "@stencil/ssr": "^0.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^19.2.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0",
    "ng-packagr": "^22.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "zone.js": "^0.15.0"
  },
  "overrides": {
    "vue-router": "^4.5.0"
  }
}
